---
import "@/styles/global.css";
import BaseHead from "@/components/Utility/BaseHead.astro";

interface Props {
  title: string;
  description: string;
  lang?: string;
  theme?: "inherit" | "light" | "dark" | "brand";
}

const { title, description, lang = "pt-BR", theme = "dark" } = Astro.props;
---

<!doctype html>
<html lang={lang} class={`theme-${theme}`}>
  <head>
    <BaseHead title={title} description={description} lang={lang} />
    <slot name="head" />
  </head>
  <body class="bg-[#08080a] text-[#f4f4f6]">
    <!-- Ambient Lighting (Jinkan Aura) -->
    <div class="fixed top-0 left-0 w-full h-full overflow-hidden -z-10 pointer-events-none">
      <div class="absolute top-[-10%] right-[-5%] w-[550px] h-[550px] bg-[#dfb15b]/10 rounded-full blur-[120px] animate-pulse"></div>
      <div class="absolute bottom-[10%] left-[-10%] w-[600px] h-[600px] bg-[#967432]/10 rounded-full blur-[140px]"></div>
    </div>

    <slot />
  </body>
</html>
