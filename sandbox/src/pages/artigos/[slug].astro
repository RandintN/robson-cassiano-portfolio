---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { marked } from "marked";
import Section from "@/components/Wrapper/Section.astro";
import ContentWrapper from "@/components/Wrapper/ContentWrapper.astro";
import Button from "@/components/Button.astro";

import articles from "../../../../src/assets/content/articles.json";

export async function getStaticPaths() {
  return articles.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

const { article } = Astro.props;

// Compile markdown content to HTML
let rawContent = article.content || "";
// Strip h1 title from markdown content to avoid duplication (since we render it explicitly)
rawContent = rawContent.replace(/^#\s+[^\n]+\n+/, "");
let articleHtml = await marked.parse(rawContent);

// Add original youtube video iframe if present
if (article.youtubeVideoId) {
  const videoCallout = `
    <div class="my-8 p-6 rounded-2xl bg-[#141418] border border-[#dfb15b]/20">
      <div class="flex flex-col sm:flex-row sm:items-center gap-2 mb-4">
        <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-red-500/10 text-red-400 border border-red-500/20 uppercase tracking-wider self-start">Gravação Original</span>
        <span class="text-xs text-slate-300 font-semibold">🎥 Quer se aprofundar? Assista à transmissão que deu origem a este ensaio:</span>
      </div>
      <div class="relative pb-[56.25%] h-0 overflow-hidden rounded-xl bg-black">
        <iframe 
          src="https://www.youtube.com/embed/${article.youtubeVideoId}?rel=0" 
          title="Transmissão Original - Robson Cassiano" 
          class="absolute top-0 left-0 w-full h-full border-0"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" 
          referrerpolicy="strict-origin-when-cross-origin"
          allowfullscreen
          loading="lazy"
        ></iframe>
      </div>
    </div>
  `;

  // Inject video callout after second h2
  let count = 0;
  let injected = false;
  articleHtml = articleHtml.replace(/<\/h2>/g, (match) => {
    count++;
    if (count === 2) {
      injected = true;
      return match + videoCallout;
    }
    return match;
  });

  if (!injected) {
    if (count === 1) {
      articleHtml = articleHtml.replace(/<\/h2>/, (match) => match + videoCallout);
    } else {
      articleHtml += videoCallout;
    }
  }
}
---

<BaseLayout title={`${article.title} | Robson Cassiano`} description={article.summary}>
  <!-- Header -->
  <header class="container mx-auto px-6 py-6 flex justify-between items-center z-10 relative">
    <a href="/sandbox/" class="flex items-center gap-3 group">
      <img
        src="/assets/icons/logo-header.webp"
        width="36"
        height="36"
        alt="Robson Cassiano"
        class="w-9 h-9 object-contain group-hover:scale-105 transition-transform drop-shadow-[0_2px_10px_rgba(223,177,91,0.25)]" />
      <div class="flex flex-col">
        <span class="font-bold text-xl tracking-tight text-white">Robson<span class="text-[#dfb15b]">Cassiano</span></span>
        <span class="text-[10px] tracking-widest uppercase font-semibold text-[#967432] font-mono">迅貫 · Jinkan (Sandbox)</span>
      </div>
    </a>

    <nav aria-label="Navegação Principal" class="hidden md:flex items-center gap-8 text-sm font-medium text-slate-400">
      <a href="/sandbox/#sobre" class="hover:text-[#dfb15b] transition-colors">Sobre</a>
      <a href="/sandbox/#artigos" class="hover:text-[#dfb15b] transition-colors">Blog</a>
      <a href="/sandbox/#faq" class="hover:text-[#dfb15b] transition-colors">FAQ</a>
      <Button href="https://global.robsoncassiano.software/" target="_blank" rel="noopener noreferrer" class="px-5 py-2">Mentoria</Button>
    </nav>
  </header>

  <!-- Article Shell -->
  <main class="flex-grow py-12">
    <Section align="center" paddingTop="none" paddingBottom="large">
      <ContentWrapper variant="stack">
        <!-- Back Link -->
        <a href="/sandbox/#artigos" class="text-sm font-semibold text-[#dfb15b] hover:text-[#f6e0a4] transition-colors flex items-center gap-1.5 mb-8">
          <span>&larr;</span> Voltar para o Blog
        </a>

        <!-- Metadata -->
        <div class="flex items-center gap-3 text-xs text-slate-400 mb-4 uppercase tracking-wider">
          <span class="px-2.5 py-1 rounded-full text-xs font-semibold bg-[#dfb15b]/10 text-[#dfb15b] border border-[#dfb15b]/25">
            {article.category}
          </span>
          <span>&bull;</span>
          <span>{article.readTime}</span>
          <span>&bull;</span>
          <span>{article.date}</span>
        </div>

        <!-- Title -->
        <h1 class="text-4xl lg:text-6xl font-bold text-white mb-6 leading-tight">
          {article.title}
        </h1>

        <!-- Author bio -->
        <div class="flex items-center gap-3 pb-8 mb-10 border-b border-[#252530]/60 w-full">
          <img src="/assets/images/Robson-Cassiano.webp" alt="Robson Cassiano" class="w-10 h-10 rounded-full object-cover border border-[#dfb15b]/30" />
          <div class="flex flex-col">
            <span class="text-sm font-bold text-white">{article.author}</span>
            <span class="text-xs text-slate-400">Senior Software Engineer na Epic Games</span>
          </div>
        </div>

        <!-- Rendered Article Body (Prose Style) -->
        <article class="prose prose-invert max-w-4xl w-full text-slate-300 leading-relaxed space-y-6">
          <Fragment set:html={articleHtml} />
        </article>

        <!-- Pre-Sold Mentorship Widget (CTA) -->
        <div class="mt-16 p-8 rounded-3xl bg-gradient-to-br from-[#141418] to-[#0e0e12] border border-[#dfb15b]/30 w-full relative overflow-hidden shadow-2xl">
          <div class="absolute top-0 right-0 p-8 opacity-5 text-8xl font-serif italic text-[#dfb15b] select-none">✦</div>
          <h3 class="text-2xl font-bold text-white mb-3">Quer faturar +R$ 30k/mês no exterior como Dev Java Sênior?</h3>
          <p class="text-slate-300 mb-6 max-w-2xl text-sm leading-relaxed">
            Participe do programa exclusivo <strong>Descomplica DEV Na Gringa</strong> conduzido pessoalmente por Robson Cassiano. Tenha seu perfil otimizado, simulações reais de entrevistas gringas e estratégias de alta negociação salarial.
          </p>
          <Button href="https://global.robsoncassiano.software/" target="_blank" rel="noopener noreferrer">
            Conhecer a Mentoria Internacional &rarr;
          </Button>
        </div>
      </ContentWrapper>
    </Section>
  </main>

  <!-- Footer -->
  <footer class="bg-[#08080a] border-t border-[#252530] py-12 relative z-10 text-center">
    <div class="container mx-auto px-6">
      <div class="text-xs text-slate-600">
        &copy; {new Date().getFullYear()} Robson Cassiano. Todos os direitos reservados.
      </div>
    </div>
  </footer>
</BaseLayout>

<style is:global>
  /* Custom Prose styles specifically for article pages to avoid tailwind-typography dependency */
  .prose h2 {
    font-size: 1.75rem;
    font-weight: 700;
    color: #ffffff;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .prose h2::before {
    content: "✦";
    color: #dfb15b;
    font-size: 1rem;
  }
  .prose h3 {
    font-size: 1.35rem;
    font-weight: 700;
    color: #ffffff;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }
  .prose p {
    margin-bottom: 1.5rem;
    font-size: 1.05rem;
    color: #cbd5e1;
  }
  .prose ul, .prose ol {
    margin-bottom: 1.5rem;
    padding-left: 1.5rem;
  }
  .prose ul {
    list-style-type: disc;
  }
  .prose ol {
    list-style-type: decimal;
  }
  .prose li {
    margin-bottom: 0.5rem;
    font-size: 1.05rem;
    color: #cbd5e1;
  }
  .prose blockquote {
    border-left: 3px solid #dfb15b;
    padding-left: 1.5rem;
    margin: 2rem 0;
    font-style: italic;
    color: #f6e0a4;
    background-color: rgba(223, 177, 91, 0.03);
    padding-top: 0.75rem;
    padding-bottom: 0.75rem;
    border-radius: 0 0.5rem 0.5rem 0;
  }
  .prose strong {
    color: #ffffff;
    font-weight: 700;
  }
</style>
