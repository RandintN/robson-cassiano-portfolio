/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Vary: Accept

# IMPORTANT: Cloudflare merges Cache-Control from every matching rule, so rules
# below are written to NEVER overlap on Cache-Control. Do not add a Cache-Control
# to /* and keep each path matched by a single caching rule.

# Hashed Angular JS bundles (content-addressed)
/*.js
  Cache-Control: public, max-age=31536000, immutable

# Hashed Angular CSS bundle: styles-<hash>.css (the un-hashed one lives in /assets/css)
/styles-*.css
  Cache-Control: public, max-age=31536000, immutable

# Static media (immutable in place)
/assets/images/*
  Cache-Control: public, max-age=31536000, immutable

/assets/icons/*
  Cache-Control: public, max-age=31536000, immutable

# Runtime data that changes on every deploy MUST revalidate (no stale CMS/i18n)
/assets/content/*
  Cache-Control: public, max-age=0, must-revalidate

/assets/i18n/*
  Cache-Control: public, max-age=0, must-revalidate

/assets/css/*
  Cache-Control: public, max-age=0, must-revalidate

# HTML documents
/index.html
  Cache-Control: public, max-age=0, must-revalidate

/artigos/*
  Cache-Control: public, max-age=0, must-revalidate

/en/*
  Cache-Control: public, max-age=0, must-revalidate

/assets/images/bimi-logo.svg
  Content-Type: image/svg+xml
  Access-Control-Allow-Origin: *

/index.md
  Content-Type: text/markdown; charset=utf-8
  Cache-Control: public, max-age=0, must-revalidate
  Access-Control-Allow-Origin: *

/index-en.md
  Content-Type: text/markdown; charset=utf-8
  Cache-Control: public, max-age=0, must-revalidate
  Access-Control-Allow-Origin: *

# Markdown alternates of each pre-rendered article (/artigos/{slug}.md).
# Cache-Control is intentionally omitted here: it is inherited from /artigos/*
# above, because Cloudflare concatenates overlapping Cache-Control rules.
/artigos/*.md
  Content-Type: text/markdown; charset=utf-8
  Access-Control-Allow-Origin: *

/llms.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=0, must-revalidate
  Access-Control-Allow-Origin: *

/llms-full.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=0, must-revalidate
  Access-Control-Allow-Origin: *

/sitemap.xml
  Content-Type: application/xml
  Cache-Control: public, max-age=0, must-revalidate

/robots.txt
  Content-Type: text/plain
  Cache-Control: public, max-age=0, must-revalidate

/api/*
  Access-Control-Allow-Origin: *
  Access-Control-Allow-Methods: GET, POST, PUT, DELETE, OPTIONS
  Access-Control-Allow-Headers: Content-Type, Authorization
  Access-Control-Max-Age: 86400
  # Nota: respostas de Pages Functions ignoram este arquivo. O X-Robots-Tag
  # efetivo para /api/* é aplicado em functions/_middleware.ts.
  X-Robots-Tag: noindex, nofollow
