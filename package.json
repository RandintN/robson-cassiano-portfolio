{
  "name": "robson-cassiano-portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "ng serve",
    "sync": "node scripts/sync-content.js",
    "build": "node scripts/sync-content.js && ng build",
    "deploy": "ng build --base-href /robson-cassiano-portfolio/",
    "pages:deploy": "bun run build && bunx wrangler pages deploy dist --project-name=robson-cassiano-portfolio --branch=master",
    "pages:dev": "bunx wrangler pages dev dist",
    "preview": "ng serve --configuration=production"
  },
  "dependencies": {
    "@angular/build": "^21.0.0",
    "@angular/cli": "^21.0.0",
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/compiler-cli": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/platform-browser": "^21.0.0",
    "marked": "^18.0.11",
    "mimetext": "^3.0.28",
    "rxjs": "^7.8.2",
    "tailwindcss": "latest"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260825.1",
    "@types/marked": "^6.0.0",
    "@types/node": "^22.14.0",
    "typescript": "^5.9.0",
    "vite": "^6.2.0",
    "wrangler": "^4.124.0"
  }
}